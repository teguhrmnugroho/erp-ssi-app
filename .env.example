# Salin file ini jadi .env untuk pengembangan lokal (opsional).
# Kalau DATABASE_URL kosong/tidak diset, aplikasi otomatis pakai SQLite lokal (erp_dev.db).

# Connection string Postgres dari Neon/Render, format:
# postgresql://<user>:<password>@<host>/<dbname>
DATABASE_URL=

# Kunci rahasia sesi Flask -- WAJIB diganti nilai acak sebelum go-live.
# Generate dgn: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# Port lokal (opsional, default 5000)
PORT=5000
